{% extends "base_play.html.twig" %}

{% block title %}Setup{% endblock %}

{% block main %}
    <div class="setup">
        <div class="dealer-div">
            <figure>
                <img src="{{ asset('img/dealer.png') }}" alt="dealer" style="width: 250px;">
                <figcaption>- How many hands you would like to play?</figcaption>
            </figure>
        </div>

        <div class="setup-form-container">
            <form action="{{ path('set_hands_form') }}" method="POST">
                <div class="setup-form-group">
                    <label for="number">Number of hands:</label>
                    <input type="number" id="number" name="numberOfHands" min="1" max="3" required>
                </div>
                <button class="btn-next" type="submit">Next >></button>
            </form>
        </div>
    </div>
{% endblock %}
{% extends "base_play.html.twig" %}

{% block title %}Play{% endblock %}

{% block main %}
    <div class="gamefield">
        <div class="gamefield-top">
            <div class="dealer-img-end">
                {% if balance < 1  %}
                    <a href="{{ path('proj_balance_restored') }}">
                        <button class="btn-newRound" type="submit">Play again</button>
                    </a>
                {% else %}
                    <a href="{{ path('set_hands') }}">
                        <button class="btn-newRound" type="submit">New round</button>
                    </a>
                {% endif %}
                <img src="{{ asset('img/dealer.png') }}" alt="dealer" style="width: 150px;">
                <a href="{{ path('proj_reset') }}">
                    <button class="btn-end" type="submit">End game</button>
                </a>
            </div>
            <div class="dealer-cards">
                {% for card in dealerHand %}
                    <img src="{{ asset('img/cards/' ~ card ~ '.png') }}" alt="{{ card }}" style="width: 80px; border-radius: 8px;">
                {% endfor %}
                <h2>{{ dealerHandValue }}</h2>
            </div>
        </div>

        <div class="gamefield-middle">
        {% for i in range(1, numberOfHands) %}
            <div class="player-middle">
                <div class="result-hand">
                    {% if results[i-1] is same as("Win")  %}
                        <h1 style="background-color: #4CAF50; text-align:center;">Win</h1>
                    {% else %}
                        <h1 style="background-color: #FF0000; text-align:center;">Loss</h1>
                    {% endif %}
                </div>
                <div class="total">
                    {% if playerHandsValues[i-1] > 21 %}
                        <h2>Bust</h2>
                    {% else %}
                        <h2>{{ playerHandsValues[i-1] }} </h2>
                    {% endif %}
                </div>
                <div class="player-cards">
                {% for card in playerHands[i-1] %}
                    <img src="{{ asset('img/cards/' ~ card ~ '.png') }}" alt="{{ card }}" style="width: 80px; border-radius: 8px;">
                {% endfor %}
                </div>
                <div class"bet">
                    {% if results[i-1] is same as("Win")  %}
                        <h3>+ {{ bets[i-1] * 2 }}</h3>
                    {% else %}
                        <h3>Bet: {{ bets[i-1] }}</h3>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
        </div>

        <div class="gamefield-bottom">
            <div class="player-img">
                <figure>
                    <img src="{{ asset('img/player.png') }}" alt="player" style="width: 150px;">
                    <figcaption>{{ name }}</figcaption>
                </figure>
                <figure>
                    <img src="{{ asset('img/money.png') }}" alt="money" style="width: 100px;">
                    <figcaption>New balance: {{ balance }} uscados</figcaption>
                </figure>
            </div>
        </div>
    </div>
{% endblock %}